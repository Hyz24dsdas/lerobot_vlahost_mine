mode: deploy

policy:
  path: /home/zzx23457/权重/clothes/openpi/pi0.5fine_tuning_tj_clothes_400_weights/149999
  device: cuda

openpi:
  # External native OpenPI checkout. deploy.py verifies this Git origin before startup.
  repo: /home/zzx23457/openpi-official
  expected_origin: https://github.com/Physical-Intelligence/openpi.git
  uv: /home/zzx23457/.local/bin/uv
  config_name: pi05_hhw_tj_clothes_400_uniform
  cache_dir: /home/zzx23457/.cache/openpi
  server_host: 127.0.0.1
  server_port: 8000
  startup_timeout_s: 300
  gripper_min: 0.0
  gripper_max: 1.0
  observation:
    image: top
    left_wrist_image: wrist_L
    right_wrist_image: wrist_R
  asset_id: clothes_400

dataset:
  root: datasets/deploy
  repo_id: local/rollout_openpi_clothes_400_evaluation
  single_task: "Pick up the crumpled garment from the center of the table and spread it out until it is fully open and flat."

staged_task:
  enabled: true
  initial_stage: spread
  switch_input: "1"
  transition:
    # Input 1 only requests a transition. The active spread chunk must finish first.
    wait_for_current_chunk: true
    completion_timeout_s: 5.0
    completion_poll_interval_s: 0.02
  stages:
    spread:
      prompt: "Pick up the crumpled garment from the center of the table and spread it out until it is fully open and flat."
    fold:
      prompt: "Fold the fully spread garment neatly, then place it into the basket on the left."

# OpenPI rollout uses the same synchronized ROS recording and Home verification
# path as the existing deployment wrapper. It does not manage node_manager.
intervention:
  enabled: true
  required: true
  session_path: /intervention/session
  heartbeat_sec: 0.5
  timeout_sec: 2.0

recording:
  enabled: true
  mode: rosbag
  required: true
  convert_to_lerobot: false
  topics:
    - /control/user/joint_cmd_A
    - /control/user/joint_cmd_B
    - /control/qp_controller/joint_cmd_A
    - /control/qp_controller/joint_cmd_B
    - /control/joint_cmd_A
    - /control/joint_cmd_B
    - /control/vr/gripperValueL
    - /control/vr/gripperValueR
    - /control/gripperValueL
    - /control/gripperValueR
    - /control/input_mode
    - /control/enableL
    - /control/enableR
    - /control/footkey
    - /info/vr_connected
    - /vlahost/intervention_trace
    - /vlahost/intervention_control_active
  backend_url: http://127.0.0.1:8080
  workspace_setup: /home/zzx23457/ws_apex/install/setup.bash
  raw_root: /home/zzx23457/record_files/deployment_recordings
  dataset_root: /home/zzx23457/record_files/lerobot_datasets/deployment_evaluations
  timeout_s: 5.0
  acquire_timeout_s: 5.0
  fps: 30
  recipe: mcap-gripper-quadtile
  rdp: /home/zzx23457/robot_data_platform/tool/rdp
  robot_type: marvin
  video_codec: h264
  crf: 20
  gop: 2
  keep_raw_after_convert: true
  task: "Pick up the crumpled garment from the center of the table and spread it out until it is fully open and flat."

robot:
  type: marvain_m6_http
  id: marvin_http_openpi_001
  http_base_url: http://127.0.0.1:8010
  timeout: 5.0
  action_chunk_path: /action_chunk
  joint_names:
    - left_arm_joint_1
    - left_arm_joint_2
    - left_arm_joint_3
    - left_arm_joint_4
    - left_arm_joint_5
    - left_arm_joint_6
    - left_arm_joint_7
    - right_arm_joint_1
    - right_arm_joint_2
    - right_arm_joint_3
    - right_arm_joint_4
    - right_arm_joint_5
    - right_arm_joint_6
    - right_arm_joint_7
    - left_gripper
    - right_gripper
  cameras:
    top:
      type: http
      fps: 30
      width: 640
      height: 480
      color_mode: rgb
    wrist_L:
      type: http
      fps: 30
      width: 640
      height: 480
      color_mode: rgb
    wrist_R:
      type: http
      fps: 30
      width: 640
      height: 480
      color_mode: rgb
  safety_stats_path: /home/zzx23457/权重/clothes_400
  action_clip_margin_deg: 0.05
  max_relative_target_deg: 0.08
  warn_on_observation_out_of_range: true

inference:
  type: chunk
  # pi0.5 predicts 50 actions. Dispatch one second at 30 Hz per inference.
  n_action_steps: 30
  chunk_interval_s: 1.0
  fps: 30.0
  duration: 0.0
  max_steps: 10000
  strategy: base
  interpolation_multiplier: 1
  return_to_initial_position: true
  home_tolerance_rad: 0.12
  home_verify_timeout_s: 12.0
  use_torch_compile: false
  show_cameras: true
  cameras_override:
    - top
    - wrist_L
    - wrist_R
  rtc:
    # Enable with: --inference-type rtc
    execution_horizon: 10
    max_guidance_weight: 10.0
    prefix_attention_schedule: EXP
    # pi0.5 returns 50 steps. Start the next inference when 30 remain.
    queue_threshold: 30
    # Stable local round-trip is about 3 steps at 30 Hz; updated online afterward.
    initial_inference_delay_steps: 3
    latency_margin_steps: 0
    latency_window: 20
    max_chunk_steps: 50
    min_send_steps: 10
